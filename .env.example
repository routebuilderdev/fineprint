# Copy to .env.local. Never commit .env.local.
# Firebase console > Project settings > Your apps > Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Cloud fallback model. Free-tier friendly default:
VITE_AI_CLOUD_MODEL=gemini-3.5-flash-lite
# Optional strongest escalation rung (only ~20 free requests/day):
VITE_AI_ESCALATION_MODEL=gemini-3.8-flash
# Optional: pin the escalation order, strongest first, comma-separated. The app appends the
# free-tier ladder after whatever you list. Use `?models=1` on probe.html to see which
# models answer today before pinning.
# VITE_AI_ESCALATION_LADDER=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.8-flash

# App Check. Use the reCAPTCHA v3 site key for a hosted build, or the debug token in dev.
VITE_APPCHECK_SITE_KEY=
# Dev only. App Check debug token from the browser console. Never commit a real value.
VITE_APPCHECK_DEBUG_TOKEN=
